<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Patrick+Hand&family=Special+Elite&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --cream:#fdf6e3;--warm:#f5edd6;
  --ink:#2c1810;--inkb:#1a3a6e;--inkr:#8b1a1a;
  --ty:rgba(255,230,100,.72);--tb:rgba(160,205,255,.72);
  --tp:rgba(220,170,255,.72);--tg:rgba(160,230,185,.72);
  --my:#ffe566;--mp:#ffb3c6;--mg:#b8f0c8;--mb:#b3d9ff;
  --sh:rgba(60,30,10,.15);
}
body{
  background:#c9bc9f;
  background-image:radial-gradient(circle at 15% 60%,rgba(170,150,110,.3) 0%,transparent 55%),radial-gradient(circle at 85% 20%,rgba(190,170,130,.2) 0%,transparent 50%);
  font-family:'Caveat',cursive;color:var(--ink);min-height:100vh;padding:24px 16px 60px;overflow-x:hidden;
}

/* ── COVER ── */
.cover{
  max-width:840px;margin:0 auto 52px;
  background:#8b1a2a;
  background-image:repeating-linear-gradient(0deg,transparent,transparent 29px,rgba(255,255,255,.04) 29px,rgba(255,255,255,.04) 30px),repeating-linear-gradient(90deg,transparent,transparent 29px,rgba(255,255,255,.04) 29px,rgba(255,255,255,.04) 30px);
  border-radius:4px 14px 14px 4px;border-left:20px solid #5a0e1a;
  padding:48px 60px 52px;
  box-shadow:-8px 0 0 #6a1020,10px 8px 36px rgba(0,0,0,.45),inset 0 0 70px rgba(0,0,0,.2);
  position:relative;animation:float 7s ease-in-out infinite;
}
.cover::before{content:'';position:absolute;left:-5px;top:30px;bottom:30px;width:3px;background:repeating-linear-gradient(to bottom,#c8a860 0,#c8a860 11px,transparent 11px,transparent 17px);}
@keyframes float{0%,100%{transform:rotate(-.3deg) translateY(0)}50%{transform:rotate(.2deg) translateY(-6px)}}

.c-avatar{width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,#ffe0a0,#ffb347);border:4px solid #f5dfa0;display:flex;align-items:center;justify-content:center;font-size:50px;position:absolute;top:40px;right:60px;box-shadow:3px 4px 14px rgba(0,0,0,.35);transform:rotate(4deg);transition:transform .3s;cursor:pointer;}
.c-avatar:hover{transform:rotate(0) scale(1.1);}

.c-title{font-family:'Special Elite',cursive;color:#f5dfa0;font-size:54px;line-height:1.05;text-shadow:2px 3px 0 rgba(0,0,0,.3);margin-bottom:6px;}
.c-sub{font-family:'Caveat',cursive;color:#e8c870;font-size:26px;font-weight:600;margin-bottom:28px;}

.badges{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:30px;}
.badge{background:var(--my);border-radius:40px;padding:5px 15px;font-size:15px;font-weight:700;color:var(--ink);border:2px solid rgba(0,0,0,.12);box-shadow:2px 2px 0 rgba(0,0,0,.15);display:inline-block;transition:transform .2s,box-shadow .2s;cursor:default;}
.badge:hover{transform:scale(1.12) rotate(-3deg);box-shadow:3px 4px 0 rgba(0,0,0,.2);}
.badge:nth-child(2n){background:var(--mp);transform:rotate(2deg);}
.badge:nth-child(3n){background:var(--mg);transform:rotate(-1.5deg);}
.badge:nth-child(4n){background:var(--mb);transform:rotate(3deg);}
.badge:nth-child(5n){background:#e0d0ff;transform:rotate(-2deg);}

.clinks{display:flex;flex-wrap:wrap;gap:10px;}
.cl{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.13);border:1.5px solid rgba(245,223,160,.35);border-radius:8px;padding:8px 16px;font-family:'Patrick Hand',cursive;font-size:16px;color:#f5dfa0;text-decoration:none;transition:background .2s,transform .2s,color .2s;}
.cl:hover{background:rgba(255,255,255,.26);transform:translateY(-2px);color:#fff;}
.cl svg{width:18px;height:18px;fill:currentColor;flex-shrink:0;}

/* ── BOARD ── */
.board{max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:start;}

/* ── PAPER ── */
.paper{
  background:var(--cream);
  background-image:repeating-linear-gradient(transparent,transparent 27px,rgba(180,155,110,.2) 27px,rgba(180,155,110,.2) 28px);
  border-radius:3px;padding:26px 26px 30px;
  box-shadow:3px 5px 14px var(--sh),0 1px 3px rgba(0,0,0,.08);
  position:relative;
  opacity:0;transform:translateY(24px);
  transition:opacity .55s,transform .55s,box-shadow .3s;
}
.paper.in{opacity:1;transform:translateY(0);}
.paper:hover{box-shadow:5px 8px 22px var(--sh);}
.paper.wide{grid-column:span 2;}
.paper.warm{background:var(--warm);background-image:repeating-linear-gradient(transparent,transparent 27px,rgba(155,125,75,.17) 27px,rgba(155,125,75,.17) 28px);}
.paper.wh{background:#fffef8;background-image:repeating-linear-gradient(transparent,transparent 27px,rgba(90,90,170,.1) 27px,rgba(90,90,170,.1) 28px);}

/* tape */
.tape{position:absolute;width:68px;height:24px;background:var(--ty);top:-12px;left:50%;transform:translateX(-50%) rotate(-2deg);pointer-events:none;border-radius:1px;}
.tape.tl{left:22%;background:var(--tb);transform:rotate(-5deg);}
.tape.tr{left:70%;background:var(--tp);transform:rotate(4deg);}
.tape.tg{background:var(--tg);}

/* pin */
.pin{width:17px;height:17px;background:radial-gradient(circle at 40% 35%,#ff6b6b,#cc1a1a);border-radius:50% 50% 50% 0;position:absolute;transform:rotate(45deg);top:-8px;left:50%;box-shadow:1px 2px 5px rgba(0,0,0,.3);}
.pin.b{background:radial-gradient(circle at 40% 35%,#6bb3ff,#1a50cc);}
.pin.g{background:radial-gradient(circle at 40% 35%,#6bff8a,#1acc45);}

/* staple */
.staple{width:28px;height:8px;border:2.5px solid #aaa;border-top:none;border-radius:0 0 4px 4px;position:absolute;top:0;left:50%;transform:translateX(-50%);}

/* section title */
.stitle{font-family:'Special Elite',cursive;font-size:21px;color:var(--ink);margin-bottom:14px;border-bottom:2px solid rgba(44,24,16,.17);padding-bottom:5px;display:flex;align-items:center;gap:8px;}

/* highlight */
.hl{background:linear-gradient(120deg,transparent 0%,var(--my) 10%,var(--my) 90%,transparent 100%);padding:0 4px;border-radius:2px;}
.hl.p{background:linear-gradient(120deg,transparent 0%,var(--mp) 10%,var(--mp) 90%,transparent 100%);}
.hl.b{background:linear-gradient(120deg,transparent 0%,var(--mb) 10%,var(--mb) 90%,transparent 100%);}
.hl.g{background:linear-gradient(120deg,transparent 0%,var(--mg) 10%,var(--mg) 90%,transparent 100%);}

/* sticky */
.sticky{background:#fffb8a;background-image:linear-gradient(to bottom,#fffb8a,#ffed40);padding:13px 15px;border-radius:0 0 0 8px;box-shadow:3px 4px 10px rgba(0,0,0,.14),inset 0 -2px 4px rgba(0,0,0,.07);font-family:'Caveat',cursive;font-size:15px;line-height:1.6;color:#2a2000;transform:rotate(2deg);position:relative;}
.sticky::before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:rgba(0,0,0,.07);}
.sticky.bl{background:#c8e8ff;background-image:linear-gradient(to bottom,#c8e8ff,#a0d4ff);color:#002060;}
.sticky.gn{background:#c8f0d8;background-image:linear-gradient(to bottom,#c8f0d8,#aadfbe);color:#003a18;}

/* ── EXPERIENCE ── */
.exp{margin-bottom:18px;padding:13px 15px;background:rgba(255,255,255,.6);border-left:4px solid var(--my);border-radius:0 5px 5px 0;transition:transform .2s;}
.exp:hover{transform:translateX(4px);}
.exp:nth-child(even){border-left-color:var(--mp);}
.exp:last-child{margin-bottom:0;}
.exp-role{font-size:19px;font-weight:700;margin-bottom:2px;}
.exp-co{font-family:'Patrick Hand',cursive;font-size:14px;color:var(--inkb);font-weight:600;margin-bottom:7px;}
.exp-ul{font-family:'Patrick Hand',cursive;font-size:13.5px;line-height:1.75;color:#3a2a20;list-style:none;}
.exp-ul li::before{content:"→ ";color:var(--inkr);font-weight:700;}

/* ── PROJECT CARDS ── */
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px;}
.pcard{background:rgba(255,255,255,.58);border-radius:8px;padding:13px 14px;border:1.5px solid rgba(44,24,16,.1);cursor:pointer;transition:transform .25s,box-shadow .25s;position:relative;overflow:hidden;text-decoration:none;color:inherit;display:block;}
.pcard::after{content:'↗';position:absolute;top:10px;right:12px;font-size:16px;opacity:0;transition:opacity .2s;color:var(--inkb);font-family:'Patrick Hand',cursive;}
.pcard:hover::after{opacity:1;}
.pcard:hover{transform:translateY(-4px) rotate(.7deg);box-shadow:5px 7px 20px rgba(60,30,10,.2);}
.pcard:active{transform:scale(.97);}
.pname{font-size:18px;font-weight:700;margin-bottom:3px;}
.ptype{font-family:'Patrick Hand',cursive;font-size:11px;background:var(--mb);color:var(--inkb);border-radius:20px;padding:2px 10px;display:inline-block;margin-bottom:7px;font-weight:600;}
.pdesc{font-family:'Patrick Hand',cursive;font-size:13px;line-height:1.6;color:#3a2a20;}
.ptag{font-size:11px;font-family:'Patrick Hand',cursive;background:rgba(44,24,16,.08);border-radius:3px;padding:1px 6px;display:inline-block;margin:3px 2px 0;}
.plive{font-family:'Caveat',cursive;font-size:13px;color:var(--inkb);margin-top:7px;display:block;}

/* ── SKILLS ── */
.scat{margin-bottom:11px;}
.scat-lbl{font-family:'Patrick Hand',cursive;font-size:12px;color:#5a4030;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px;}
.sc{display:flex;flex-wrap:wrap;gap:6px;}
.sp{font-family:'Patrick Hand',cursive;font-size:13px;font-weight:600;padding:4px 12px;border-radius:28px;border:1.5px solid rgba(0,0,0,.08);transition:transform .2s,box-shadow .2s;cursor:default;}
.sp:hover{transform:scale(1.12) rotate(-2deg);box-shadow:2px 3px 8px rgba(0,0,0,.14);}
.sp.a{background:#ffd166;color:#5a3e00;}
.sp.b{background:#b3d9ff;color:#0a2a5a;}
.sp.c{background:#b8f0c8;color:#0a3a1a;}
.sp.d{background:#ffc0cb;color:#5a0a1a;}
.sp.e{background:#e0d0ff;color:#3a0a6a;}

/* ── ACHIEVEMENTS ── */
.ach{display:flex;align-items:flex-start;gap:11px;margin-bottom:11px;padding:9px 12px;background:rgba(255,255,255,.55);border-radius:6px;border:1px solid rgba(44,24,16,.09);transition:transform .2s;}
.ach:hover{transform:translateX(5px);}
.ach-ico{font-size:24px;flex-shrink:0;}
.ach-txt{font-family:'Patrick Hand',cursive;font-size:14px;line-height:1.5;}
.ach-lbl{font-size:16px;font-weight:700;display:block;}

/* ── RAG BARS ── */
.rb{margin-bottom:10px;}
.rb-hd{font-family:'Patrick Hand',cursive;font-size:12.5px;color:#3a2a20;display:flex;justify-content:space-between;margin-bottom:3px;}
.rb-track{height:10px;background:rgba(44,24,16,.1);border-radius:10px;overflow:hidden;}
.rb-fill{height:100%;border-radius:10px;width:0;transition:width 1.2s cubic-bezier(.4,0,.2,1);}

/* ── POLAROID ── */
.polar-row{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;}
.polar{background:#fff;padding:11px 11px 34px;box-shadow:3px 4px 14px rgba(0,0,0,.18);width:142px;text-align:center;transition:transform .25s,box-shadow .25s;cursor:pointer;position:relative;}
.polar:nth-child(1){transform:rotate(-4deg);}
.polar:nth-child(2){transform:rotate(3deg);}
.polar:nth-child(3){transform:rotate(-2deg);}
.polar:nth-child(4){transform:rotate(4.5deg);}
.polar:hover{transform:rotate(0) scale(1.1)!important;box-shadow:5px 6px 22px rgba(0,0,0,.24);z-index:10;}
.polar-img{width:120px;height:86px;display:flex;align-items:center;justify-content:center;font-size:42px;background:linear-gradient(135deg,#f0f0f0,#e0e0e0);border-radius:2px;margin-bottom:7px;}
.polar-cap{font-family:'Caveat',cursive;font-size:13px;color:#333;line-height:1.3;}

/* ── CONTACT ── */
.cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px;}
.cta{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.6);border-radius:8px;padding:13px 15px;border:1.5px solid rgba(44,24,16,.11);text-decoration:none;color:var(--ink);transition:transform .2s,box-shadow .2s,background .2s;}
.cta:hover{transform:translateY(-4px);box-shadow:4px 6px 18px rgba(60,30,10,.2);background:rgba(255,255,255,.9);}
.cta-ico{font-size:29px;flex-shrink:0;}
.cta-lbl{font-family:'Patrick Hand',cursive;font-size:12px;color:#888;margin-bottom:1px;}
.cta-val{font-size:16px;font-weight:700;}

/* ── NAV ── */
.nav{position:fixed;right:14px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:9px;z-index:200;}
.nd{width:11px;height:11px;border-radius:50%;background:rgba(44,24,16,.26);border:none;cursor:pointer;padding:0;transition:background .2s,transform .2s;position:relative;}
.nd:hover,.nd.on{background:#8b1a2a;transform:scale(1.45);}
.nd .tip{position:absolute;right:18px;top:50%;transform:translateY(-50%);white-space:nowrap;font-family:'Caveat',cursive;font-size:12.5px;background:rgba(255,250,235,.93);padding:2px 8px;border-radius:4px;opacity:0;pointer-events:none;transition:opacity .2s;color:var(--ink);}
.nd:hover .tip{opacity:1;}

/* ── SCROLL TO TOP ── */
#totop{position:fixed;bottom:22px;right:20px;width:40px;height:40px;background:#8b1a2a;color:#f5dfa0;border:none;border-radius:50%;font-size:20px;cursor:pointer;box-shadow:2px 3px 10px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(0);transition:opacity .3s,transform .3s;z-index:300;}
#totop.show{opacity:1;transform:scale(1);}
#totop:hover{background:#6a0e1a;transform:scale(1.1)!important;}

.footer{max-width:900px;margin:40px auto 10px;text-align:center;font-size:18px;color:rgba(44,24,16,.45);font-style:italic;}

@keyframes pop{0%{opacity:1;transform:scale(.5) translateY(0) rotate(0)}70%{opacity:1;transform:scale(1.4) translateY(-50px) rotate(200deg)}100%{opacity:0;transform:scale(.6) translateY(-90px) rotate(380deg)}}

@media(max-width:640px){
  .board{grid-template-columns:1fr;}
  .paper.wide{grid-column:span 1;}
  .pgrid{grid-template-columns:1fr;}
  .cta-grid{grid-template-columns:1fr;}
  .c-title{font-size:38px;}
  .c-avatar{width:78px;height:78px;font-size:34px;top:26px;right:18px;}
  .cover{padding:38px 22px 42px;}
  .nav{display:none;}
}
</style>
</head>
