<script>
/* 1. Paper entrance */
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
},{threshold:.1});
document.querySelectorAll('.paper').forEach(p=>io.observe(p));

/* 2. RAG bars */
const ragIO=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.rb-fill').forEach(b=>{
        b.style.width='0';setTimeout(()=>b.style.width=b.dataset.w+'%',100);
      });
      ragIO.unobserve(e.target);
    }
  });
},{threshold:.3});
const ragSec=document.getElementById('s7');
if(ragSec)ragIO.observe(ragSec);

/* 3. Nav dots */
const secIds=['s0','s1','s3','s4','s5','s7','s9'];
const dots=document.querySelectorAll('.nd');
dots.forEach(d=>d.addEventListener('click',()=>{
  const t=document.getElementById(d.dataset.s);
  if(t)t.scrollIntoView({behavior:'smooth',block:'start'});
}));
window.addEventListener('scroll',()=>{
  let cur=0;
  secIds.forEach((id,i)=>{const el=document.getElementById(id);if(el&&el.getBoundingClientRect().top<window.innerHeight*.55)cur=i;});
  dots.forEach((d,i)=>d.classList.toggle('on',i===cur));
},{passive:true});

/* 4. Scroll to top */
const tb=document.getElementById('totop');
window.addEventListener('scroll',()=>tb.classList.toggle('show',scrollY>380),{passive:true});

/* 5. Confetti burst */
const emos=['✨','🎉','⚡','🚀','💡','🔥','🎊','🌟','💫'];
function burst(cx,cy){
  for(let i=0;i<10;i++){
    const s=document.createElement('span');
    s.textContent=emos[Math.floor(Math.random()*emos.length)];
    const l=cx+(-60+Math.random()*120),t=cy+(-40+Math.random()*80);
    s.style.cssText=`position:fixed;pointer-events:none;z-index:9999;left:${l}px;top:${t}px;font-size:${18+Math.random()*18}px;animation:pop .9s ease forwards;`;
    document.body.appendChild(s);setTimeout(()=>s.remove(),950);
  }
}
document.querySelectorAll('.pcard').forEach(c=>c.addEventListener('click',e=>{burst(e.clientX,e.clientY);}));
document.querySelectorAll('.polar').forEach(p=>p.addEventListener('click',()=>{
  const r=p.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2);
}));

/* 6. Avatar easter egg */
const avEmojis=['🦋','🌸','⭐','🚀','🧠','✨','🎯','💫','🦄','🌈'];
let avI=0;
document.getElementById('avBtn').addEventListener('click',function(){
  avI=(avI+1)%avEmojis.length;this.textContent=avEmojis[avI];
  const r=this.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2);
});

/* 7. Paper tilt */
document.querySelectorAll('.paper').forEach(p=>{
  p.addEventListener('mousemove',e=>{
    const r=p.getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
    p.style.transform=`translateY(-4px) rotate(${x*3}deg)`;
  });
  p.addEventListener('mouseleave',()=>p.style.transform='');
});

/* 8. Badge hover wobble */
document.querySelectorAll('.badge').forEach(b=>{
  b.addEventListener('mouseenter',()=>{b.style.transition='transform .15s';b.style.transform='scale(1.12) rotate(-3deg)';});
  b.addEventListener('mouseleave',()=>{b.style.transform='';});
});
</script>
